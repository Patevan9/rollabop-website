{
  "_readme": "Words and diagrams used on the Home and How to Play pages. Edit text freely. Diagram coordinates are in ball-widths: x from the left, y from the floor. Ball states: 'held', 'from' (where a ball came from), 'match', 'fall', 'touch', 'hint'. A 'tag' marks something as not final: e.g. 'Planned', 'In design', 'Later'.",
  "hero": {
    "eyebrow": "A game by Lippy Robotics Labs",
    "headline": "The physical pile is the puzzle.",
    "body": "Reach into a living pile of balls, rearrange it under gravity, build larger matches, and discover the move that changes everything.",
    "secondaryLabel": "See how it plays",
    "secondaryHref": "#how-it-plays"
  },
  "whatIs": {
    "eyebrow": "What is Rollabop?",
    "title": "A puzzle you can reach into.",
    "intro": "Rollabop is played inside a tall walnut tray full of clear, glowing balls. Nothing is locked in place. Every ball has weight, and every move changes the pile.",
    "features": [
      {
        "name": "Physical",
        "color": "blue",
        "text": "Move any ball. Everything around it reacts."
      },
      {
        "name": "Clever",
        "color": "gold",
        "text": "Build rows of 3, 4, 5 or more. Bigger thinking earns bigger rewards."
      },
      {
        "name": "Calm",
        "color": "green",
        "text": "No frantic clock. Observe the board and make your move."
      },
      {
        "name": "Alive",
        "color": "purple",
        "text": "Gravity, collisions and cascades can change the puzzle after every move."
      }
    ]
  },

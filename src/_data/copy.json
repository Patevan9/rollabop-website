    "noGrid": {
      "title": "No grid. No swapping.",
      "text": "Balls are never locked into cells, and you never trade two neighbours. You carry a ball through a real pile, let go, and gravity decides what happens next."
    },
    "principle": "Match 3 or more. Larger matches earn more."
  },
  "galaxy": {
    "eyebrow": "Galaxy Balls",
    "title": "Some balls are more than pieces.",
    "body": "Discover and collect spectacular Galaxy Balls, each with its own miniature world inside.",
    "fairness": "Beauty, never power. A Galaxy Ball's rarity or price never makes it stronger than another. Each Galaxy design simply forms its own matching family.",
    "note": "How Galaxy Balls are discovered and collected will be shared closer to release."
  },
  "levels": {
    "eyebrow": "Levels & puzzles",
    "title": "It begins with a match. It becomes a puzzle.",
    "intro": "Early levels teach the feel of the pile. Later ones ask you to stop, look, and plan a move that sets off something bigger.",
    "items": [
      {
        "name": "Handcrafted levels",
        "text": "Designed by hand to reward a moment of insight.",
        "tag": "Planned"
      },
      {
        "name": "Larger-match challenges",
        "text": "Goals that ask for rows of 4, 5 or more.",
        "tag": "In design"
      },
      {
        "name": "Cascades",
        "text": "Set up chain reactions where one clear causes the next.",
        "tag": ""
      },
      {
        "name": "Physical structures",
        "text": "Elegant obstacles that change how the pile moves, later in the journey.",
        "tag": "Planned"
      },
      {
        "name": "Mastery",
        "text": "Solved levels stay worth replaying, to play them better. Star ratings are planned.",
        "tag": ""
      }
    ]
  },
  "respect": {
    "eyebrow": "Player-first design",
    "title": "Made to respect the player.",
    "lines": [
      "No surprise ads.",
      "No fake urgency.",
      "No frantic timers.",
      "No pay-to-win progression.",
      "No punishment for thoughtful play."
    ],
    "promise": "Every level can be beaten by a thoughtful player without paying and without watching an ad.",
    "note": "Optional rewarded ads may come later, and only ever when you choose them."
  },
  "accessibility": {
    "eyebrow": "Accessibility",
    "title": "Clear to see. Comfortable to play.",
    "intro": "Rollabop is still in development. This is the direction we are building toward.",
    "items": [
      {
        "name": "More than colour",
        "text": "Matching information should not rely on colour alone. Shape cues for each ball family are in development."
      },
      {
        "name": "Readable contrast",
        "text": "Clear, high-contrast text and controls on the dark wood."
      },
      {
        "name": "Every screen size",
        "text": "Layouts designed for phones, tablets and foldables, folded or open."
      },
      {
        "name": "Your sound, your way",
        "text": "Sound, music and haptics controllable independently."
      },
      {
        "name": "More to come",
        "text": "Additional accessibility options are planned."
      }
    ]
  },
  "studio": {
    "eyebrow": "The studio",
    "text": "Rollabop is created by Lippy Robotics Labs, an independent studio exploring tactile games, local AI, robotics and technology."
  },

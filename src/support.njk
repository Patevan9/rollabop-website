{%- import "macros.njk" as ui -%}
<section class="page-hero">
  <div class="wrap wrap--narrow">
    <p class="eyebrow">Support</p>
    <h1 class="page-title">How can we help?</h1>
    <p class="lead">Answers for common questions, and how to reach us.</p>
    <nav class="jump" aria-label="On this page">
      <ul role="list">
        <li><a href="#gameplay">Gameplay help</a></li>
        <li><a href="#technical">Technical issues</a></li>
        <li><a href="#saving">Saving &amp; progress</a></li>
        <li><a href="#purchases">Purchases</a></li>
        <li><a href="#accessibility">Accessibility</a></li>

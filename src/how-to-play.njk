---
layout: base.njk
title: How to Play
description: Learn to play Rollabop in seven short cards. Make matches, use the physics, set up cascades.
pageClass: guide
permalink: /how-to-play/
---
{%- import "macros.njk" as ui -%}
{%- set g = copy.howToPlay -%}
<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow">Guide</p>
    <h1 class="page-title">{{ g.title }}</h1>
    <p class="lead">{{ g.intro }}</p>
  </div>
</section>

<section class="section section--tight" aria-label="Instruction cards">
  <div class="wrap">
    <ol class="cards" role="list">
      {%- for card in g.cards %}
      <li class="card" data-reveal>
        <div class="card__visual">
          {%- if card.diagram %}
          {{ ui.diagram(card.diagram, "Diagram: " + card.title, "card" + loop.index) }}
          {%- else %}
          <div class="diagram-panel card__icon" aria-hidden="true">
            {%- if card.icon == "objective" %}
            <svg viewBox="0 0 120 60"><rect x="30" y="8" width="60" height="44" rx="4" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M40 22h40M40 30h30M40 38h34" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity=".7"/></svg>
            {%- elif card.icon == "stars" %}
            <svg viewBox="0 0 120 60"><g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">{% for x in [32, 60, 88] %}<path transform="translate({{ x }} 31)" d="M0 -14 L4.1 -4.8 L13.8 -4.3 L6.2 2 L8.6 11.6 L0 6.2 L-8.6 11.6 L-6.2 2 L-13.8 -4.3 L-4.1 -4.8 Z"/>{% endfor %}</g></svg>
            {%- elif card.icon == "obstacle" %}
            <svg viewBox="0 0 120 60"><path d="M18 22 L70 34" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><circle cx="18" cy="22" r="3" fill="currentColor"/><circle cx="70" cy="34" r="3" fill="currentColor"/><circle cx="88" cy="46" r="9" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".7"/><circle cx="40" cy="14" r="9" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".7"/></svg>
            {%- endif %}
          </div>
          {%- endif %}
        </div>
        <div class="card__body">
          <p class="card__num" aria-hidden="true">{{ "0" + loop.index }}</p>
          <h2 class="card__title">{{ card.title }} {{ ui.tag(card.tag) }}</h2>
          <p>{{ card.text }}</p>
        </div>
      </li>
      {%- endfor %}
    </ol>
    <p class="guide-foot muted">Rollabop is still in development. Cards marked <span class="tag">Planned</span>, <span class="tag">In design</span> or <span class="tag">Later</span> describe our direction, not finished features.</p>
  </div>
</section>

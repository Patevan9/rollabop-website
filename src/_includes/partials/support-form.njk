{#- The Get Help form. Sends through Formspree (site.json → supportForm.formspreeId).
    Works without JavaScript (a normal form post); with JavaScript it stays on this page. -#}
<form class="support-form" id="support-form" action="https://formspree.io/f/{{ site.supportForm.formspreeId }}" method="POST" novalidate>
  <input type="hidden" name="_subject" value="Rollabop Support Request">
  <p class="visually-hidden" aria-hidden="true"><label>Leave this empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off"></label></p>

  <fieldset>
    <legend>Your information</legend>
    <div class="field-row">
      <p class="field"><label for="sf-name">Name <span class="optional">(optional)</span></label>
        <input id="sf-name" name="name" type="text" autocomplete="name"></p>
      <p class="field"><label for="sf-email">Email</label>
        <input id="sf-email" name="email" type="email" autocomplete="email" required></p>
    </div>
  </fieldset>

  <fieldset>
    <legend>What do you need help with?</legend>
    <p class="field"><label for="sf-category">Category</label>
      <select id="sf-category" name="category" required>
        <option value="">Select one…</option>
        <option>Gameplay question</option>
        <option>Bug or problem</option>
        <option>Purchase or payment</option>
        <option>Accessibility</option>
        <option>Feedback or suggestion</option>
        <option>Other</option>
      </select></p>

    <p class="field"><label for="sf-device">Device <span class="optional">(optional)</span></label>
      <input id="sf-device" name="device" type="text" placeholder="e.g. Samsung Galaxy Fold 7"></p>

    <p class="field"><label for="sf-message">Message</label>
      <textarea id="sf-message" name="message" rows="7" required placeholder="Tell us what happened, what you were trying to do, or how we can help."></textarea></p>
  </fieldset>

  <p class="form-status" role="status" aria-live="polite" hidden></p>
  <p><button class="btn btn--primary" type="submit">Send support request</button></p>
  <p class="small muted">Your message is sent through Formspree to our support inbox. See our <a href="/privacy/">Privacy Policy</a>.</p>
</form>
